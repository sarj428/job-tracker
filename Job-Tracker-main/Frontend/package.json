{
  "name": "careertrack-frontend",
  "version": "1.0.0",
  "main": "index.js",
  "author": "sarj428",
  "license": "MIT",
  "scripts": {
    "start": "node loadEnv.js && react-scripts start",
    "build": "node loadEnv.js && react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "test:coverage": "react-scripts test --watchAll=false --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format:check": "prettier --check src",
    "format": "prettier --write src",
    "eject": "react-scripts eject"
  },
  "keywords": [],
  "description": "CareerTrack – a Kanban-style job application tracker built with React",
  "dependencies": {
    "dotenv": "^10.0.0",
    "js-cookie": "^3.0.5",
    "react": "^18.3.1",
    "react-dnd": "^14.0.5",
    "react-dnd-html5-backend": "^14.1.0",
    "react-dom": "^18.3.1",
    "react-scripts": "^5.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "prettier": "^3.9.10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.js",
      "!src/setupTests.js"
    ]
  }
}
